#. translators: %s: list of checkout field names, such as "Street address and Town / City"
#: functions-private.php:228
#, php-format
msgid "We can only print delivery labels in Latin (English) letters. Please re-enter your %s using Latin letters only, or give an address, such as a PO box, that can be written that way."
msgstr "Etykiety wysyłkowe możemy drukować wyłącznie przy użyciu liter łacińskich (angielskich). Prosimy o ponowne wprowadzenie %s, używając wyłącznie liter łacińskich, lub podanie adresu, np. skrytki pocztowej, który można zapisać w ten sposób."

#: includes/class-order-note.php:101
msgid "Latin Address Checkout converted these address fields to plain ASCII for the delivery label:"
msgstr "Funkcja „Latin Address Checkout” przekonwertowała te pola adresowe na zwykły kod ASCII na potrzeby etykiety wysyłkowej:"

#. translators: 1: field name, such as "Shipping town / city", 2: value as the customer entered it, 3: value stored on the order
#: includes/class-order-note.php:107
#, php-format
msgid "%1$s: %2$s → %3$s"
msgstr "%1$s: %2$s → %3$s"
